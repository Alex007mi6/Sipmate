# SipMate environment template — copy to .env and fill in secrets.
# Never commit real .env files.

APP_NAME=SipMate
ENVIRONMENT=development
DEBUG=true

# PostgreSQL (SQLAlchemy URL)
DATABASE_URL=postgresql+psycopg://sipmate:sipmate@localhost:5432/sipmate

# Auth
SECRET_KEY=replace-with-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_NAME=sipmate_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origins (comma-separated). Production: your https://….onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Built SPA directory (served by FastAPI in production Docker image)
FRONTEND_DIST=frontend/dist

# Image storage: local | cloudinary | s3
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Seed admin (used by scripts/seed.py) — change before any shared deployment
ADMIN_EMAIL=admin@sipmate.example
ADMIN_PASSWORD=change-me-admin-password
ADMIN_DISPLAY_NAME=SipMate Admin
